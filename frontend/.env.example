# CẤU HÌNH FRONTEND AI HUB VN (Vite chỉ đọc tệp frontend/.env, sao chép tệp này thành frontend/.env)
# CẤU HÌNH KẾT NỐI FIREBASE
# Lấy các thông số này từ Firebase Console: Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=ai-hub-vn.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-hub-vn
VITE_FIREBASE_STORAGE_BUCKET=ai-hub-vn.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# LƯU TRỮ DÙNG CHUNG TRÊN FIRESTORE (bật sau khi triển khai database/firestore.rules, xem 20_QUY_TRINH_TRIEN_KHAI.md mục 5.3)
# Khi bật, quyền quản trị lấy từ Firestore (admins/{uid}), không dùng VITE_ADMIN_EMAIL
VITE_FIRESTORE_ENABLED=false

# EMAIL QUẢN TRỊ VIÊN (ADMIN) CAO NHẤT CÓ QUYỀN DUYỆT CÔNG CỤ (chỉ dùng khi chưa bật Firestore)
VITE_ADMIN_EMAIL=vinhngtien@gmail.com
