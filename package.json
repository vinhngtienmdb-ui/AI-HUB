{
  "name": "quan-ly-cong-cu-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @aihub/frontend",
    "build": "npm run build -w @aihub/frontend",
    "preview": "npm run preview -w @aihub/frontend",
    "typecheck": "npm run typecheck -w @aihub/frontend",
    "test": "npm test --workspaces --if-present",
    "mcp:stdio": "npm start -w @aihub/backend",
    "mcp:api": "npm run api -w @aihub/backend",
    "mcp:test": "npm run selftest -w @aihub/backend",
    "data:validate": "npm run validate -w @aihub/database --",
    "test:rules": "npm run test:rules -w @aihub/database"
  }
}
