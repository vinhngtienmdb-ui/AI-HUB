# CẤU HÌNH BACKEND AI HUB VN (Máy chủ MCP và Cổng REST API)
# Backend không tự đọc tệp .env: đặt các biến này trong môi trường shell hoặc dịch vụ chạy tiến trình.

# CẤU HÌNH CỔNG REST API GATEWAY (npm run mcp:api) - TẤT CẢ ĐỀU TÙY CHỌN
# Địa chỉ lắng nghe, mặc định 127.0.0.1 (chỉ máy cục bộ)
# AIHUB_API_HOST=127.0.0.1
# AIHUB_API_PORT=4000
# Muối HMAC cho khóa API; bỏ trống để hệ thống tự sinh và lưu tại backend/data/.security-salt
# AIHUB_SECURITY_SALT=
# Các nguồn trình duyệt được phép gọi API ngoài localhost, phân tách bằng dấu phẩy
# AIHUB_ALLOWED_ORIGINS=https://aihub.example.vn
# Đặt 1 khi chạy sau reverse proxy để tin cậy tiêu đề X-Forwarded-For
# AIHUB_TRUST_PROXY=0
# Đường dẫn kho dữ liệu công cụ, mặc định database/data/allTools.json
# AIHUB_TOOLS_FILE=
