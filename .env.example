# CẤU HÌNH KẾT NỐI FIREBASE CHO AI HUB VN
# Lấy các thông số này từ Firebase Console: Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=ai-hub-vn.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-hub-vn
VITE_FIREBASE_STORAGE_BUCKET=ai-hub-vn.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# LƯU TRỮ DÙNG CHUNG TRÊN FIRESTORE (bật sau khi triển khai firestore.rules, xem 20_QUY_TRINH_TRIEN_KHAI.md mục 5.3)
# Khi bật, quyền quản trị lấy từ Firestore (admins/{uid}), không dùng VITE_ADMIN_EMAIL
VITE_FIRESTORE_ENABLED=false

# EMAIL QUẢN TRỊ VIÊN (ADMIN) CAO NHẤT CÓ QUYỀN DUYỆT CÔNG CỤ (chỉ dùng khi chưa bật Firestore)
VITE_ADMIN_EMAIL=vinhngtien@gmail.com

# CẤU HÌNH CỔNG REST API GATEWAY (npm run mcp:api) - TẤT CẢ ĐỀU TÙY CHỌN
# Địa chỉ lắng nghe, mặc định 127.0.0.1 (chỉ máy cục bộ)
# AIHUB_API_HOST=127.0.0.1
# AIHUB_API_PORT=4000
# Muối HMAC cho khóa API; bỏ trống để hệ thống tự sinh và lưu tại mcp-gateway/data/.security-salt
# AIHUB_SECURITY_SALT=
# Các nguồn trình duyệt được phép gọi API ngoài localhost, phân tách bằng dấu phẩy
# AIHUB_ALLOWED_ORIGINS=https://aihub.example.vn
# Đặt 1 khi chạy sau reverse proxy để tin cậy tiêu đề X-Forwarded-For
# AIHUB_TRUST_PROXY=0
